# =============================================================================
# JIMAS FRONTEND - ENVIRONMENT VARIABLES
# Copy this file to ".env" and set your backend URL.
# In Create React App, variables MUST start with REACT_APP_ to be used.
# You must restart "npm start" (or rebuild) after changing this.
# =============================================================================

# The base URL of your backend API (no trailing slash).
REACT_APP_API_BASE=https://jimas-backend-api.onrender.com/

# Keeps CI warnings from failing the production build (already used by build script).
CI=false
